<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/mc_bg">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="58dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/mc_primary_dark" android:paddingStart="4dp" android:paddingEnd="6dp">
        <TextView android:id="@+id/btnBack" android:layout_width="42dp" android:layout_height="58dp"
            android:gravity="center" android:text="‹" android:textColor="#FFFFFF" android:textSize="34sp"/>
        <TextView android:id="@+id/txtTitle" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center_vertical" android:text="MyCable Pro"
            android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:id="@+id/btnMore" android:layout_width="42dp" android:layout_height="58dp"
            android:gravity="center" android:text="⋮" android:textColor="#FFFFFF" android:textSize="28sp"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true">
      <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:padding="14dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Vanakkam,\nAdmin" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/mc_text"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="78dp" android:orientation="horizontal" android:layout_marginTop="10dp">
          <TextView android:id="@+id/statTotal" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
              android:gravity="center" android:text="👥 Total Customers\n0" android:textSize="14sp" android:background="@drawable/bg_card"/>
          <TextView android:id="@+id/statActive" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
              android:layout_marginStart="7dp" android:gravity="center" android:text="✓ Active\n0" android:textSize="14sp" android:background="@drawable/bg_advance"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="78dp" android:orientation="horizontal" android:layout_marginTop="7dp">
          <TextView android:id="@+id/statDue" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
              android:gravity="center" android:text="⊗ Due\n₹0" android:textSize="14sp" android:background="@drawable/bg_due"/>
          <TextView android:id="@+id/statAdvance" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
              android:layout_marginStart="7dp" android:gravity="center" android:text="₹ Advance\n₹0" android:textSize="14sp" android:background="@drawable/bg_advance"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quick Actions"
            android:textSize="18sp" android:textStyle="bold" android:textColor="@color/mc_text" android:layout_marginTop="14dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="82dp" android:orientation="horizontal" android:layout_marginTop="7dp">
          <TextView android:id="@+id/actionCustomers" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="👥\nCustomers" android:background="@drawable/bg_card"/>
          <TextView android:id="@+id/actionBilling" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▣\nBilling" android:background="@drawable/bg_card" android:layout_marginStart="6dp"/>
          <TextView android:id="@+id/actionCollection" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="₹\nCollection" android:background="@drawable/bg_card" android:layout_marginStart="6dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="82dp" android:orientation="horizontal" android:layout_marginTop="6dp">
          <TextView android:id="@+id/actionPackages" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="📦\nPackages" android:background="@drawable/bg_card"/>
          <TextView android:id="@+id/actionZones" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="📍\nZones" android:background="@drawable/bg_card" android:layout_marginStart="6dp"/>
          <TextView android:id="@+id/actionReports" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▥\nReports" android:background="@drawable/bg_card" android:layout_marginStart="6dp"/>
        </LinearLayout>
        <Button android:id="@+id/btnImportExcel" android:layout_width="match_parent" android:layout_height="50dp" android:text="Import Excel"
            android:textColor="#FFFFFF" android:textAllCaps="false" android:background="@drawable/bg_blue" android:layout_marginTop="10dp"/>
        <Button android:id="@+id/btnExportExcel" android:layout_width="match_parent" android:layout_height="50dp" android:text="Export Excel"
            android:textColor="#FFFFFF" android:textAllCaps="false" android:background="@drawable/bg_green" android:layout_marginTop="8dp"/>
      </LinearLayout>
    </ScrollView>

    <LinearLayout android:id="@+id/bottomNav" android:layout_width="match_parent" android:layout_height="62dp"
        android:orientation="horizontal" android:gravity="center" android:background="#FFFFFF">
        <TextView android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="⌂\nHome" android:textSize="11sp"/>
        <TextView android:id="@+id/navCustomers" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="♙\nCustomers" android:textSize="11sp"/>
        <TextView android:id="@+id/navBilling" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="▣\nBilling" android:textSize="11sp"/>
        <TextView android:id="@+id/navReports" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="▤\nReports" android:textSize="11sp"/>
    </LinearLayout>

</LinearLayout>
